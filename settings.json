{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git show *)",
      "Bash(git show)",
      "Bash(git blame *)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git stash)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git switch *)",
      "Bash(git remote *)",
      "Bash(git remote)",
      "Bash(git tag *)",
      "Bash(git tag)",
      "Bash(pytest *)",
      "Bash(pytest)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv sync)",
      "Bash(uv pip list *)",
      "Bash(uv pip list)",
      "Bash(uv list)",
      "Bash(uv list *)",
      "Bash(uv python)",
      "Bash(uv python *)",
      "Bash(python *)",
      "Bash(python)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(env *)",
      "Bash(env)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(python3)",
      "Bash(python3 *)",
      "Bash(.venv/bin/python3)",
      "Bash(.venv/bin/python3 *)",
      "Bash(sed)",
      "Bash(sed *)",
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git commit *)",
      "Bash(git commit)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(pip *)"
    ],
    "additionalDirectories": [
      "/home/jonn/Documents/Code"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; echo \"$f\" | grep -qE '\\.py$' && uv run black --quiet \"$f\"; } 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "voltagent-core-dev@voltagent-subagents": true,
    "voltagent-lang@voltagent-subagents": true,
    "voltagent-infra@voltagent-subagents": true,
    "voltagent-qa-sec@voltagent-subagents": true,
    "voltagent-data-ai@voltagent-subagents": true,
    "voltagent-dev-exp@voltagent-subagents": true,
    "voltagent-domains@voltagent-subagents": true,
    "voltagent-biz@voltagent-subagents": true,
    "voltagent-meta@voltagent-subagents": true,
    "voltagent-research@voltagent-subagents": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "voltagent-subagents": {
      "source": {
        "source": "github",
        "repo": "VoltAgent/awesome-claude-code-subagents"
      }
    }
  },
  "promptSuggestionEnabled": true
}
