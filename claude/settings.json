  "statusLine": {
    "type": "command",
    "command": "bash -c 'input=$(cat); cwd=$(echo \"$input\" | jq -r \".workspace.current_dir // .cwd\"); name=$(basename \"$cwd\"); model=$(echo \"$input\" | jq -r \".model.display_name // empty\"); used=$(echo \"$input\" | jq -r \".context_window.used_percentage // empty\"); printf \"\\033[1;32m[$(whoami)@$(hostname -s) %s]\\033[0m\" \"$name\"; [ -n \"$model\" ] && printf \" \\033[0;36m%s\\033[0m\" \"$model\"; [ -n \"$used\" ] && printf \" \\033[0;33mctx:%.0f%%\\033[0m\" \"$used\"'"
